DEFINE <USER> $USER

NUM_REALIZATIONS 1

-- PEM parameter setting - for test purposes only. The use of PATH pointers is
-- not the same as in a real ERT PEM run
DEFINE <PEM_PATH> <CONFIG_PATH>/../../sim2seis/model
DEFINE <MODEL_PATH> <PEM_PATH>
DEFINE <PEM_CONFIG_FILE_NAME> pem_config_no_condensate.yml
RUNPATH <CONFIG_PATH>/../..
DEFINE <GLOBAL_PATH> fmuconfig/output
DEFINE <GLOBAL_CONFIG_FILE> global_variables.yml
DEFINE <MOD_PREFIX> HIST
DEFINE <VERBOSE_FLAG> true

-- Run the PEM
FORWARD_MODEL PEM(<CONFIG_DIR>=<PEM_PATH>, <CONFIG_FILE>=<PEM_CONFIG_FILE_NAME>, <GLOBAL_DIR>=<GLOBAL_PATH>, <GLOBAL_FILE>=<GLOBAL_CONFIG_FILE>, <MOD_DATE_PREFIX>=<MOD_PREFIX>, <MODEL_DIR>=<MODEL_PATH>, <VERBOSE>=<VERBOSE_FLAG>)
