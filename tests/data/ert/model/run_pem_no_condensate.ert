DEFINE <USER> $USER

NUM_REALIZATIONS 1

-- PEM parameter setting
DEFINE <PEM_CONFIG_FILE_NAME> pem_config_no_condensate.yml
DEFINE <PATH_PEM> <CONFIG_PATH>/../../sim2seis/model
DEFINE <MODEL_PATH> <CONFIG_PATH>/../../sim2seis/model
DEFINE <GLOBAL_PATH> ../../fmuconfig/output
DEFINE <GLOBAL_CONFIG_FILE> global_variables.yml

-- Run the PEM
FORWARD_MODEL PEM(<CONFIG_DIR>=<PATH_PEM>, <CONFIG_FILE>=<PEM_CONFIG_FILE_NAME>, <MODEL_DIR>=<MODEL_PATH>, <GLOBAL_DIR>=<GLOBAL_PATH>, <GLOBAL_FILE>=<GLOBAL_CONFIG_FILE>)
